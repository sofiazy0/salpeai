# Server-only settings. Never commit real keys.
APP_URL=https://your-project.vercel.app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=

# AnyModel documentation could not be accessed during initial implementation.
# The adapter is intentionally OFF until the contract is confirmed.
# Set the following ONLY if docs confirm OpenAI-compatible streaming completions:
# ANYMODEL_API_FORMAT=openai-chat-completions
ANYMODEL_API_FORMAT=
# Exact HTTPS endpoint from AnyModel docs, on anymodel.org or its subdomains:
ANYMODEL_CHAT_URL=
ANYMODEL_API_KEY=
# Replace with actual model IDs from AnyModel; no model IDs are assumed.
# ANYMODEL_MODELS_JSON=[{"id":"verified-model-id","name":"Model name"}]
ANYMODEL_MODELS_JSON=
