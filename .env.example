# Server-only settings. Never commit real keys.
APP_URL=https://your-project.vercel.app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=

# AnyModel uses an OpenAI-compatible Chat Completions endpoint.
ANYMODEL_API_FORMAT=openai-chat-completions
ANYMODEL_CHAT_URL=https://anymodel.org/v1/chat/completions
# Keep the real API key only in Vercel environment variables / .env.local.
ANYMODEL_API_KEY=
# Verified AnyModel model IDs. Adjust this list if you want a different picker.
ANYMODEL_MODELS_JSON=[{"id":"gpt-5.6-sol","name":"GPT-5.6 Sol"},{"id":"gpt-5.6-terra","name":"GPT-5.6 Terra"},{"id":"gpt-5.6-luna","name":"GPT-5.6 Luna"}]
